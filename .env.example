# Local Python scripts use localhost. Docker Compose services use .env.docker.
# Copy this file to .env for manual script debugging.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=crypto-trades
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT
KAFKA_TOPIC_PARTITIONS=4
KAFKA_PRODUCER_RETRIES=5
KAFKA_PRODUCER_FLUSH_INTERVAL=10000

# PostgreSQL / TimescaleDB
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=crypto_pipeline
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=changeme

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Spark
PARQUET_OUTPUT=/tmp/crypto_raw
CHECKPOINT_DIR=/tmp/checkpoint
RESET_SPARK_STATE=false
# Day 5 Azure preferred path with Managed Identity:
# PARQUET_OUTPUT=abfss://raw-trades@<account>.dfs.core.windows.net/
AZURE_STORAGE_ACCOUNT=

# Docker Compose values belong in .env.docker:
# KAFKA_BOOTSTRAP_SERVERS=kafka:9093
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# Google Gemini AI summary
GEMINI_API_KEY=your_key_here
