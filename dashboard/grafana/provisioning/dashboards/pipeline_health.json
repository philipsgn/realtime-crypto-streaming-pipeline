          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIMESCALEDB}"
          },
          "rawSql": "SELECT COUNT(*) AS value FROM trade_metrics_1min WHERE window_start >= NOW() - INTERVAL '1 minute' AND $__timeFilter(window_start)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pipeline Throughput (records/min)",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "id": 2,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIMESCALEDB}"
      },
      "description": "Healthy pipeline shows consistent non-zero values. Gaps indicate Spark was down or stopped writing.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "axisLabel": "records / min",
            "axisColorMode": "text",
            "axisBorderShow": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "insertNulls": false,
            "scaleDistribution": { "type": "linear" },
