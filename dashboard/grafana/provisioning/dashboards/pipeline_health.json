    {
      "type": "table",
      "title": "Symbol Coverage — All 8 Symbols",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 8 },
      "id": 4,
      "description": "Shows which symbols are actively being processed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIMESCALEDB}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green" }]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": ["sum"],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIMESCALEDB}"
          },
          "rawSql": "SELECT symbol, COUNT(*) AS total_records, MAX(window_start) AS last_seen, ROUND(AVG(trade_count)::numeric, 0) AS avg_trades_per_min, ROUND(AVG(total_volume)::numeric, 4) AS avg_volume_per_min FROM trade_metrics_1min WHERE $__timeFilter(window_start) GROUP BY symbol ORDER BY total_records DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
