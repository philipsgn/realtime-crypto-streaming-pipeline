            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "thresholdsStyle": { "mode": "off" },
            "stacking": { "mode": "none", "group": "A" }
          },
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green" }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIMESCALEDB}"
          },
          "rawSql": "SELECT date_trunc('minute', window_start) AS time, COUNT(*) AS value FROM trade_metrics_1min WHERE $__timeFilter(window_start) GROUP BY 1 ORDER BY 1 ASC",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Seconds Since Last Record",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 4 },
      "id": 3,
      "description": "Most important health signal. Green means pipeline is actively writing; red means Spark stopped writing.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIMESCALEDB}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIMESCALEDB}"
          },
          "rawSql": "SELECT EXTRACT(EPOCH FROM (NOW() - MAX(window_start))) AS value FROM trade_metrics_1min WHERE $__timeFilter(window_start)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
