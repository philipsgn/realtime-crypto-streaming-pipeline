      "id": 1,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIMESCALEDB}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red" },
              { "color": "green", "value": 1 }
