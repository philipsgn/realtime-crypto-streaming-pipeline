      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Active Symbol Count — Latest Window",
      "description": "Symbols present in the latest completed Gold window. Healthy state is 8/8.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIMESCALEDB}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 8 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIMESCALEDB}"
          },
          "rawSql": "SELECT COUNT(DISTINCT symbol) AS value FROM gold_minute_volume WHERE window_start = (SELECT MAX(window_start) FROM gold_minute_volume)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Trade Count Throughput — Last 1 Hour",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "id": 2,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIMESCALEDB}"
      },
      "description": "Real Binance trade events processed per minute. Gaps indicate Spark stopped writing completed windows.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "axisLabel": "trades / min",
            "axisColorMode": "text",
            "axisBorderShow": false,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "insertNulls": false,
            "scaleDistribution": { "type": "linear" },
            "axisCenteredZero": false,
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "thresholdsStyle": { "mode": "off" },
            "stacking": { "mode": "none", "group": "A" }
          },
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green" }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIMESCALEDB}"
          },
          "rawSql": "SELECT window_start AS time, SUM(trade_count) AS value FROM gold_minute_volume WHERE $__timeFilter(window_start) GROUP BY window_start ORDER BY window_start ASC",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Data Freshness — Last 1 Hour",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 3,
      "description": "Most important health signal. Green means pipeline is actively writing; red means Spark stopped writing.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIMESCALEDB}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIMESCALEDB}"
          },
          "rawSql": "SELECT EXTRACT(EPOCH FROM (NOW() - MAX(window_start))) AS value FROM gold_minute_volume WHERE $__timeFilter(window_start)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Aggregation Window Count — All Time",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 5,
      "description": "Exact count of one-minute symbol windows persisted since June 13, 2026. This is not an estimate of raw trades.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIMESCALEDB}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIMESCALEDB}"
          },
          "rawSql": "SELECT COUNT(*) AS value FROM gold_minute_volume",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Trades — All Time",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 7,
      "description": "Cumulative Binance trades processed across all 8 symbols. This KPI ignores the dashboard time picker.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIMESCALEDB}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIMESCALEDB}"
          },
          "rawSql": "SELECT COALESCE(SUM(trade_count), 0) AS value FROM gold_minute_volume",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "table",
      "title": "Symbol Coverage & Freshness — All 8 Symbols",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 4,
      "description": "Operational dropout detection. Red freshness above five minutes means a symbol stopped updating.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIMESCALEDB}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green" }]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "minutes_since_last"},
            "properties": [
              {"id": "unit", "value": "m"},
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 5}]}}
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": ["sum"],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIMESCALEDB}"
          },
          "rawSql": "SELECT symbol, COUNT(*) AS total_windows, MAX(window_start) AS last_seen, ROUND((EXTRACT(EPOCH FROM (NOW() - MAX(window_start))) / 60)::numeric, 1) AS minutes_since_last, ROUND(AVG(trade_count)::numeric, 0) AS avg_trades_per_min FROM gold_minute_volume GROUP BY symbol ORDER BY minutes_since_last ASC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Data Quality Score % — Last 1 Hour",
      "description": "Share of Gold windows with positive VWAP, volume and trade count.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "id": 6,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIMESCALEDB}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 95},
              {"color": "green", "value": 99}
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIMESCALEDB}"
          },
          "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE minute_vwap > 0 AND base_volume > 0 AND trade_count > 0) / NULLIF(COUNT(*), 0), 1) AS value FROM gold_minute_volume WHERE $__timeFilter(window_start)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    }
  ],
